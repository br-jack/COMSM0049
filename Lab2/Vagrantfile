Vagrant.configure("2") do |config|
  config.vm.define "box" do |box|
    box.vm.hostname = "lab2-box"
    box.ssh.password = "vagrant"   # optional, only if you want to skip the prompt

    box.vm.provider "virtualbox" do |vb, override|
      vb.name = "lab2-box"
      override.vm.box = "hashicorp/precise32"
      override.vm.provision "shell", inline: <<-SHELL
        sed -i.bak -r 's/(extras|us.archive|us.security|security).(ubuntu|canonical).com/old-releases.ubuntu.com/g' /etc/apt/sources.list
        apt-get update -y
        apt-get install -y gdb
      SHELL
    end

    box.vm.provider "libvirt" do |lv, override|
      lv.default_prefix = ""
      lv.memory = 1024
      override.vm.box = "generic/ubuntu1604"
      override.vm.synced_folder ".", "/vagrant", type: "rsync",
        rsync__exclude: [".git/", ".vagrant/"]
      override.vm.provision "shell", inline: <<-SHELL
        dpkg --add-architecture i386
        apt-get update -y
        apt-get install -y gdb libc6:i386 gcc-multilib
      SHELL
    end
  end
end
